{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DDlauncher",
  "version": "0.1.0",
  "identifier": "com.fixtan.ddlauncher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DDlauncher",
        "width": 944,
        "height": 700,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "fixtan",
    "shortDescription": "Win10風タイル型スタートメニューランチャー",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
